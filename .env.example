# Домен без https:// и без слэша на конце.
# Для локального запуска оставьте localhost.
SITE_DOMAIN=water-fix.ru

# Публичный адрес сайта (используется в документации и письмах)
SITE_URL=https://water-fix.ru

# --- PostgreSQL ---
POSTGRES_DB=waterfix
POSTGRES_USER=waterfix
# Только латиница и цифры, без ; и кавычек. Например: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-strong-password

# --- JWT ---
# Сгенерируйте: openssl rand -base64 48
JWT_SECRET=change-me-at-least-32-characters-long

# --- Администратор ---
# Создаётся при первом запуске, если админов ещё нет.
# Пароль — длинный случайный: openssl rand -base64 24
ADMIN_EMAIL=admin@water-fix.ru
ADMIN_PASSWORD=change-me-strong-admin-password

# --- Яндекс.Карты (необязательно) ---
# Ключ нужен только для выбора точки водомата в админке.
# Без него координаты можно ввести вручную.
VITE_YANDEX_MAPS_KEY=

# --- SMTP (необязательно) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password
